# Runtime settings for server/server.mjs

# Port exposed by the Node server inside the container/process.
PORT=3000

# Bind host. Use 0.0.0.0 for containers/app services.
HOST=0.0.0.0

# Comma-separated allowlist for BYOK provider targets.
# Strongly recommended for production so user keys can only be forwarded to approved domains.
BYOK_ALLOWED_TARGETS=https://internal-beta.expedient.cloud,https://api.openai.com,https://api.anthropic.com
IMAGE_ALLOWED_TARGETS=https://images.unsplash.com,https://upload.wikimedia.org
WEB_FETCH_ALLOWED_TARGETS=https://www.microsoft.com,https://learn.microsoft.com
ADDIN_ORIGIN=https://your-addin-domain.example.com
REQUIRE_AUTH=true
AUTH_VALIDATOR_MODULE=./server/auth.mjs
# Replace these fail-closed contract templates with separately managed production modules.
TENANT_POLICY_MODULE=./server/tenant-policy.production.example.mjs
SETTINGS_STORE_MODULE=./server/settings-store.production.example.mjs
RATE_LIMITER_MODULE=./server/rate-limiter.production.example.mjs
AUDIT_LOG_STDOUT=false
REQUEST_MAX_BYTES=2000000
PROXY_MAX_BYTES=2000000
PROXY_MAX_RESPONSE_BYTES=10000000
OUTBOUND_TIMEOUT_MS=15000
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_EXPENSIVE_PER_MINUTE=30

# Microsoft 365 delegated Graph access for cross-app context.
# Register an Entra app for Office SSO. Use the same app id in manifest.xml WebApplicationInfo.
# If omitted, Office SSO/device login returns placeholder setup guidance instead of guessing an app id.
# Production should set these explicitly and replace file token cache with MSAL/Entra + backend session/vault storage.
# Concrete tenant ids permitted to use this deployment. Tenant authorization fails
# closed: if this is unset or lists common/organizations/*, every request is rejected.
AUTHORIZED_TENANTS=
MSAL_CLIENT_ID=
MSAL_TENANT_ID=
GRAPH_SCOPES=openid profile User.Read Files.Read

# Required for production Graph access from Office SSO. Store the secret/certificate in a vault.
MSAL_CLIENT_SECRET=
OFFICE_SSO_RESOURCE=api://your-addin-domain.example.com/<real-client-id>

# Development-only escape hatch. Do not define this variable in production;
# production readiness fails closed when it is present.
# GRAPH_ACCESS_TOKEN=

# Development-only compatibility. Do not define this variable in production;
# production readiness fails closed when it is present.
# M365_COMPAT_TOKEN_PATH=

# Optional local-development cache paths. These are prohibited in production;
# production readiness fails closed when any token/cache path variable is present.
# M365_TOKEN_CACHE_PATH=
# M365_DEVICE_FLOW_PATH=
